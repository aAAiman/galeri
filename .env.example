# GaleriKita Production Environment Template
# Duplicate this file to .env and configure for your deployment

# Database Configuration (MySQL 8.0)
DATABASE_URL=mysql://galeri:galerikita_secure_password@db:3306/galerikita
DB_HOST=db
DB_PORT=3306
DB_USER=galeri
DB_PASSWORD=galerikita_secure_password
DB_NAME=galerikita
DB_CONNECTION_LIMIT=5

# Storage Configuration (Default 50 GB Quota)
STORAGE_DIR=/app/storage
STORAGE_QUOTA_BYTES=50000000000

# Authentication & Security
# Generasikan string acak 32+ karakter untuk SESSION_SECRET
SESSION_SECRET=replace_with_a_very_long_secure_random_string_2026
DEFAULT_PASSWORD=galerikita2026
